function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
function err_(e){return {ok:false,error:String(e||'คำขอไม่สำเร็จ')};}
function doGet(){return json_({ok:true,service:'NYC Krungthai Registration',version:NYC_VERSION});}
function doPost(e){try{if(!e?.postData?.contents||e.postData.contents.length>300000)return json_(err_('Invalid request'));const p=JSON.parse(e.postData.contents);if(!p.secret||!same_(p.secret,sharedSecret_()))return json_(err_('Unauthorized'));const act=String(p.action||'');if(act==='ping'){init_();return json_({ok:true,version:NYC_VERSION,ready:true});}if(act==='config')return json_({ok:true,config:config_()});if(act==='requestOtp')return json_(requestOtp_(p.data||{}));if(act==='register')return json_(register_(p.data||{}));if(act==='adminDashboard')return json_(dashboard_());if(act==='adminUsers')return json_(users_(p.data||{}));if(act==='adminUserSave')return json_(userSave_(p.data||{}));if(act==='adminImport')return json_(adminImport_(p.data||{}));if(act==='adminOptions')return json_({ok:true,options:options_(false)});if(act==='adminOptionSave')return json_(optionSave_(p.data||{}));if(act==='adminSettings')return json_({ok:true,settings:settings_()});if(act==='adminSettingsSave')return json_(settingsSave_(p.data||{}));if(act==='adminExport')return json_(export_(p.data||{}));return json_(err_('Unknown action'));}catch(e){console.error('Backend error: '+String(e&&e.message||'unknown').slice(0,90));return json_(err_('Backend request failed'));}}
function sharedSecret_(){if(typeof getSharedSecret_ !== 'function')throw Error('Backend secret missing');return getSharedSecret_();}
function same_(a,b){a=String(a);b=String(b);let diff=a.length^b.length;for(let i=0;i<Math.max(a.length,b.length);i++)diff|=(a.charCodeAt(i)||0)^(b.charCodeAt(i)||0);return diff===0;}
function lock_(fn){const l=LockService.getScriptLock();l.waitLock(20000);try{return fn();}finally{l.releaseLock();}}
function book_(){const b=SpreadsheetApp.getActiveSpreadsheet();if(!b)throw Error('No bound spreadsheet');return b;}
function sheet_(name,headers){let s=book_().getSheetByName(name);if(!s){s=book_().insertSheet(name);s.getRange(1,1,1,headers.length).setValues([headers]).setBackground('#E4F0F5').setFontWeight('bold');s.setFrozenRows(1);s.getRange(1,1,s.getMaxRows(),headers.length).setNumberFormat('@');}return s;}
function rows_(name,headers){const s=sheet_(name,headers);const n=s.getLastRow();return n<2?[]:s.getRange(2,1,n-1,headers.length).getDisplayValues();}
function text_(v,max=160){return String(v===null||v===undefined?'':v).trim().slice(0,max);}
function cell_(v,max=160){const x=text_(v,max);return /^[=+@\-\t\r]/.test(x)?"'"+x:x;}
function truth_(v){return String(v).trim().toLowerCase()==='true';}
function hash_(input){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,input).map(x=>(x&255).toString(16).padStart(2,'0')).join('');}
function normEmail_(s){return text_(s,150).toLowerCase();}
function validEmail_(s){return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(s)&&s.length<=150;}
function today_(){return Utilities.formatDate(new Date(),'Asia/Bangkok','yyyy-MM-dd');}
function now_(){return new Date().toISOString();}
function fmt_(v){return String(v===null||v===undefined?'':v);}
